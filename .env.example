# yume environment configuration
# Copy to .env and fill in. Never commit .env.

# Gradium voice API key (used by voice_service/)
GRADIUM_API_KEY=
GRADIUM_STT_INPUT_FORMAT=opus
GRADIUM_STT_LANGUAGE=en
GRADIUM_STT_DELAY_IN_FRAMES=16
YUME_DISABLE_LOCAL_AUDIO_CLEANUP=0

# Anthropic API key for the foreground orchestrator agent
ANTHROPIC_API_KEY=

# Optional model overrides
YUME_FOREGROUND_MODEL=claude-sonnet-4-6
YUME_WORKER_MODEL=claude-sonnet-4-6
YUME_FOREGROUND_EFFORT=medium
YUME_FOREGROUND_MAX_TOKENS=8192
HERMES_INFERENCE_PROVIDER=anthropic
HERMES_INFERENCE_MODEL=claude-sonnet-4-6
HERMES_REASONING_EFFORT=medium

# Local helper ports (loopback only)
YUME_VOICE_PORT=7421
YUME_AGENT_PORT=7422

# Hermes binary, if not on PATH
HERMES_BIN=hermes
YUME_HERMES_MODE=auto

# Debug
YUME_DEBUG=0
YUME_LOG_SCREENSHOTS=0
YUME_LOG_RAW_AUDIO=0
